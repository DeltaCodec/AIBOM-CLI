# AI-BOM configuration — fill gaps the scanner can't auto-detect

project:
  name: "my-ml-project"
  version: "1.0.0"
  description: "Optional project description"
  authors:
    - name: "Your Name"
      email: "you@example.com"

# Datasets the scanner may not find automatically
datasets:
  - name: "ImageNet"
    source: "https://image-net.org"
    version: "ILSVRC2012"
    license: "custom-non-commercial"
    gdpr_relevant: false
    confidential: false
    hash: ""  # SHA-256 of your local copy

  - name: "Internal Customer Data"
    source: "internal"
    version: "2024-Q1"
    license: "proprietary"
    gdpr_relevant: true
    confidential: true
    hash: ""

# Models manually tracked
models:
  - name: "bert-base-uncased"
    source: "huggingface"
    source_id: "bert-base-uncased"
    license: "Apache-2.0"
    version: "1.0"

# License allowlist — packages with these licenses pass compliance
license_allowlist:
  - MIT
  - Apache-2.0
  - BSD-2-Clause
  - BSD-3-Clause
  - ISC
  - Python-2.0
  - PSF-2.0

# GDPR-relevant source patterns (added to built-in list)
gdpr_sources:
  - "internal-user-data"
  - "customer-feedback"

# Output settings
output:
  path: "aibom-output.json"
  include_audit_trail: true
